import os
import pandas as pd
import cv2
import matplotlib.pyplot as plt

# 1. Clone the repository directly into Colab
REPO_NAME = "semicon-drift-sense"
REPO_URL = f"https://github.com/urjadoshi2024etc-creator/semicon-drift-sense.git"

if not os.path.exists(REPO_NAME):
    print("Cloning repository from GitHub...")
    !git clone {REPO_URL}
else:
    print("Repository already cloned.")

# 2. Set project paths
PROJECT_ROOT = f"/content/semicon-drift-sense"
DATASET_DIR = os.path.join(PROJECT_ROOT, "dram_sem_dataset_v2")
CSV_PATH = os.path.join(DATASET_DIR, "labels.csv")

# 3. Load and inspect the metadata CSV
if os.path.exists(CSV_PATH):
    df = pd.read_csv(CSV_PATH)
    print(f"\n Successfully loaded labels.csv ({len(df)} sample pairs found)")
    print("\nFirst 5 rows of dataset annotations:")
    display(df.head())
else:
    raise FileNotFoundError(f"Could not find labels.csv at path: {CSV_PATH}")

# 4. Visualization Function: Plot matched Reference vs. Search image pairs
def plot_sample_pair(row_idx: int = 0):
    row = df.iloc[row_idx]
    
    # Resolve relative image paths
    ref_full_path = os.path.join(DATASET_DIR, row["ref_path"])
    search_full_path = os.path.join(DATASET_DIR, row["search_path"])
    
    # Read images using OpenCV
    ref_img = cv2.imread(ref_full_path, cv2.IMREAD_GRAYSCALE)
    search_img = cv2.imread(search_full_path, cv2.IMREAD_GRAYSCALE)
    
    if ref_img is None or search_img is None:
        print(f"Error loading images for Pair ID: {row['pair_id']}")
        return
        
    # Plot side-by-side comparison
    fig, axes = plt.subplots(1, 2, figsize=(12, 6))
    
    axes[0].imshow(ref_img, cmap="gray")
    axes[0].set_title(f"Reference Frame (100x High-Dose)\nPair ID: {row['pair_id']}", fontsize=11, fontweight="bold")
    axes[0].axis("off")
    
    axes[1].imshow(search_img, cmap="gray")
    axes[1].set_title(
        f"Search Frame (10x Low-Dose)\nDrift: (dx={row['dx_px']:.2f}px, dy={row['dy_px']:.2f}px) | Rot: {row['rotation_deg']:.2f}°\nDefect: {row['defect_type']}",
        fontsize=11,
        fontweight="bold"
    )
    axes[1].axis("off")
    
    plt.tight_layout()
    plt.show()

# 5. Display sample pairs from the dataset
print("\n--- Visualizing Sample Image Pairs ---")
plot_sample_pair(row_idx=0)
plot_sample_pair(row_idx=1)
